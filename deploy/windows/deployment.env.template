# Copy this file as .env in the same directory. Do not commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xc_diagnosis
DB_USERNAME=root
DB_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
DEPLOY_API_PORT=18080
# Empty uses deploy\runtime\data\knowledge-files. Set an absolute local path only when required.
KNOWLEDGE_STORAGE_ROOT=
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Only use these two values when initializing a brand-new database.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Prometheus 只由 Spring Boot 调用。请填写本机可访问的基础地址，禁止将真实地址提交到仓库。
MONITORING_PROMETHEUS_BASE_URL=REPLACE_WITH_LOCAL_PROMETHEUS_URL
MONITORING_PROMETHEUS_CONNECT_TIMEOUT=3s
MONITORING_PROMETHEUS_READ_TIMEOUT=8s
# 资源级 Prometheus 地址默认拒绝；按部署环境明确填写允许的域名或 CIDR。
MONITORING_PROMETHEUS_ALLOWED_HOSTS=
MONITORING_PROMETHEUS_ALLOWED_CIDRS=
# 使用稳定服务名或运行环境实际 instance 标签，禁止在模板中写入真实 Docker 内部 IP。
MONITORING_TARGETS_NODE_INSTANCE=REPLACE_WITH_NODE_EXPORTER_INSTANCE
MONITORING_TARGETS_MYSQL_INSTANCE=REPLACE_WITH_MYSQLD_EXPORTER_INSTANCE
